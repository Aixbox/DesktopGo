{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopGo",
  "version": "1.0.0",
  "identifier": "com.aixbox.desktopgo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MkY4QkFCNUZBNjVEMDcKUldRSFhhWmZxNHN2R1hIRysxOUwxOFlCbEs3aS9KVVJMMXNFUXJKNzhHN3BXa2g3Ri9lckFrcDEK",
      "endpoints": [
        "https://github.com/Aixbox/DesktopGo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "publisher": "Aixbox",
    "homepage": "https://github.com/Aixbox/DesktopGo",
    "copyright": "Copyright (c) Aixbox",
    "license": "MIT",
    "licenseFile": "../LICENSE.txt",
    "shortDescription": "面向 Windows 的桌面启动台，整合应用唤起、图标整理与文件搜索。",
    "longDescription": "DesktopGo 是一个面向 Windows 的桌面启动台，把应用唤起、图标整理和基于 Everything 的文件搜索整合到同一个入口中，并提供全屏展示、快捷键呼出与应用内更新能力。",
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": [
          "SimpChinese"
        ],
        "customLanguageFiles": {
          "SimpChinese": "nsis/SimpChinese.nsh"
        }
      }
    },
    "resources": [
      "resources/everything/**/*",
      "resources/everything-installer/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
